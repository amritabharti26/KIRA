    <string name="about_kira_title">About Kira App</string>

    <string name="kira_app">Kira</string>

    <string name="kira_tagline">Women Safety App</string>

    <string name="about_kira_heading">About Kira</string>

    <string name="about_kira_description">
    Kira is an AI-powered mobile safety application
    designed to provide quick assistance during emergency
    situations. It combines smart SOS triggers, emergency
    communication, location services, and evidence recording
    to help users respond quickly when they feel unsafe.
</string>

    <string name="key_features">Key Features</string>

    <string name="key_features_list">
    • Multi-Trigger SOS
    • AI Voice SOS
    • Smart Shake Detection
    • Emergency SMS &amp; Calling
    • Live Location Sharing
    • Evidence Recording
    • AI Danger Zones
    • Alert History
    • Offline Safety Support
</string>

    <string name="technology">Technology</string>

    <string name="technology_list">
    • Android Studio &amp; Java
    • Firebase Authentication
    • Firebase Realtime Database
    • OpenStreetMap
    • Smartphone Sensors
    • Speech Recognition
</string>

