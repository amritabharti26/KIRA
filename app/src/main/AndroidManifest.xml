<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Emergency SMS -->
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- Emergency Calling -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- Voice SOS -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Camera for Evidence Recording -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Foreground service for tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- For Android 13+ Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiraApp"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity android:name=".LoginActivity"/>
        <activity android:name=".RegisterActivity"/>

        <!-- Main Dashboard -->
        <activity android:name=".MainActivity"/>

        <!-- Emergency Contacts -->
        <activity android:name=".EmergencyContactsActivity"/>
        <activity android:name=".AddContactActivity"/>

        <!-- Live Tracking -->
        <activity android:name=".LiveLocationActivity"/>

        <!-- Safety Tips -->
        <activity android:name=".SafetyTipsActivity"/>

        <!-- Alert History -->
        <activity android:name=".AlertHistoryActivity"/>

        <!-- SOS Emergency Alert -->
        <activity android:name=".EmergencyAlertActivity"
            android:screenOrientation="portrait"/>

        <!-- Danger Zones -->
        <activity android:name=".DangerZonesActivity"/>

        <!-- Profile -->
        <activity android:name=".ProfileActivity"/>

        <!-- About -->
        <activity android:name=".AboutActivity"/>

    </application>

</manifest>