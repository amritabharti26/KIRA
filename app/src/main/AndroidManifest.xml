<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Emergency SMS -->
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- Emergency Calling -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- Voice SOS -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Camera for Evidence Recording -->
    <uses-permission android:name="android.permission.CAMERA"/>


    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />


    <!-- Optional hardware features -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />


    <!-- For Android 13+ Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiraApp"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity android:name=".LoginActivity"/>
        <activity android:name=".RegisterActivity"/>

        <!-- Safety Setup -->
        <activity
            android:name=".SafetySetupActivity"
            android:exported="false" />

        <service
            android:name=".EvidenceRecordingService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />



        <!-- Main Dashboard -->
        <activity android:name=".MainActivity"/>

        <!-- Emergency Contacts -->
        <activity android:name=".EmergencyContactsActivity"/>
        <activity android:name=".AddContactActivity"/>

        <!-- Live Tracking -->
        <activity android:name=".LiveLocationActivity"/>

        <!-- Safety Tips -->
        <activity android:name=".SafetyTipsActivity"/>

        <!-- Alert History -->
        <activity android:name=".AlertHistoryActivity"/>

        <activity
            android:name=".EvidenceActivity"
            android:exported="false" />

        <!-- SOS Emergency Alert -->
        <activity android:name=".EmergencyAlertActivity"/>

        <!-- Danger Zones -->
        <activity android:name=".DangerZonesActivity"/>

        <!-- Profile -->
        <activity android:name=".ProfileActivity"/>

        <!-- Feedback -->
        <activity
            android:name=".FeedbackActivity"
            android:exported="false" />

        <!-- Admin Feedback -->
        <activity
            android:name=".AdminFeedbackActivity"
            android:exported="false" />

        <!-- About -->
        <activity android:name=".AboutActivity"
            android:exported="false" />

    </application>

</manifest>